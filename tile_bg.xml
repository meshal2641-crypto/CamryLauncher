<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient android:angle="270" android:startColor="#FF2A7BFF" android:endColor="#FF0F3E99" />
            <corners android:radius="28dp" />
            <stroke android:width="2dp" android:color="@color/silver" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="270" android:startColor="#FF111B2E" android:endColor="#FF0A1222" />
            <corners android:radius="28dp" />
            <stroke android:width="2dp" android:color="#FF1E6BFF" />
        </shape>
    </item>
</selector>
